<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Python Web App - Week 2</title>
    <style>
        body {
            background: #fff6cc;
            color: #14213d;
            font-family: Arial, sans-serif;
            max-width: 750px;
            margin: 50px auto;
            padding: 30px;
            text-align: center;
        }
        h1 { color: #e6498b; }
        .counter {
            background: white;
            padding: 30px;
            border-radius: 15px;
